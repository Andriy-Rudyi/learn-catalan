  Corrections to verbecc 1.9.7's Catalan data.

  verbecc's Catalan data (conjugations-ca.xml, verbs-ca.xml) comes from
  Verbiste (c) 2003-2016 Pierre Sarrazin and catverbs by Neil Roberts,
  under the GNU General Public License, version 2 or later. These
  corrections change that data and are under the same licence, unlike
  the rest of this project (MIT).

  Endings follow verbecc's own notation: they are appended to the verb
  stem, each leading hyphen deletes one letter from the stem first ("mou"
  plus "-gut" gives "mogut"), and a lone hyphen means the form does not
  exist.  Templates marked modify-stem="strip-accents" receive a stem
  whose diacritics are already removed, so an accent wanted in the output
  has to sit in the ending: "sab" plus two hyphens and "àpiga" gives
  "sàpiga".

  Patches to existing templates come first: a template fix repairs every
  verb that uses it.  New templates follow, inheriting a base template
  and listing only what differs.  Verb re-assignments come last.
-->
<corrections lang="ca">

  <!-- ==== futures and conditionals of the -er/-re groups ============
       The e/i-less endings produced "perdé" for "perdré", "temà" for
       "temeràs", "nria" for "naixeria". -->

  <template name="perd:re">
    <Indicatiu>
      <futur>
        <p><i>ré</i></p><p><i>ràs</i></p><p><i>rà</i></p>
        <p><i>rem</i></p><p><i>reu</i></p><p><i>ran</i></p>
      </futur>
    </Indicatiu>
  </template>

  <template name="tém:er">
    <Indicatiu>
      <futur>
        <p><i>eré</i></p><p><i>eràs</i></p><p><i>erà</i></p>
        <p><i>erem</i></p><p><i>ereu</i></p><p><i>eran</i></p>
      </futur>
    </Indicatiu>
    <Condicional>
      <present>
        <p><i>eria</i></p><p><i>eries</i></p><p><i>eria</i></p>
        <p><i>eríem</i></p><p><i>eríeu</i></p><p><i>erien</i></p>
      </present>
    </Condicional>
  </template>

  <template name="créix:er">
    <Indicatiu>
      <futur>
        <p><i>eré</i></p><p><i>eràs</i></p><p><i>erà</i></p>
        <p><i>erem</i></p><p><i>ereu</i></p><p><i>eran</i></p>
      </futur>
    </Indicatiu>
    <Condicional>
      <present>
        <p><i>eria</i></p><p><i>eries</i></p><p><i>eria</i></p>
        <p><i>eríem</i></p><p><i>eríeu</i></p><p><i>erien</i></p>
      </present>
    </Condicional>
    <!-- créixer -> crescut, merèixer -> merescut (was "creixut") -->
    <Particip>
      <particip>
        <p><i>--scut</i></p><p><i>--scuda</i></p>
        <p><i>--scuts</i></p><p><i>--scudes</i></p>
      </particip>
    </Particip>
  </template>

  <template name="conèix:er">
    <Condicional>
      <present>
        <p><i>eria</i></p><p><i>eries</i></p><p><i>eria</i></p>
        <p><i>eríem</i></p><p><i>eríeu</i></p><p><i>erien</i></p>
      </present>
    </Condicional>
    <!-- conèixer -> conegut, aparèixer -> aparegut (was "coneixut") -->
    <Particip>
      <particip>
        <p><i>--gut</i></p><p><i>--guda</i></p>
        <p><i>--guts</i></p><p><i>--gudes</i></p>
      </particip>
    </Particip>
  </template>

  <template name="pertàny:er">
    <Indicatiu>
      <futur>
        <p><i>eré</i></p><p><i>eràs</i></p><p><i>erà</i></p>
        <p><i>erem</i></p><p><i>ereu</i></p><p><i>eran</i></p>
      </futur>
    </Indicatiu>
    <Condicional>
      <present>
        <p><i>eria</i></p><p><i>eries</i></p><p><i>eria</i></p>
        <p><i>eríem</i></p><p><i>eríeu</i></p><p><i>erien</i></p>
      </present>
    </Condicional>
    <!-- pertànyer -> pertangut (was "pertanyut") -->
    <Particip>
      <particip>
        <p><i>-gut</i></p><p><i>-guda</i></p>
        <p><i>-guts</i></p><p><i>-gudes</i></p>
      </particip>
    </Particip>
  </template>

  <template name="n:àixer">
    <Indicatiu>
      <futur>
        <p><i>aixeré</i></p><p><i>aixeràs</i></p><p><i>aixerà</i></p>
        <p><i>aixerem</i></p><p><i>aixereu</i></p><p><i>aixeran</i></p>
      </futur>
    </Indicatiu>
    <Condicional>
      <present>
        <p><i>aixeria</i></p><p><i>aixeries</i></p><p><i>aixeria</i></p>
        <p><i>aixeríem</i></p><p><i>aixeríeu</i></p><p><i>aixerien</i></p>
      </present>
    </Condicional>
  </template>

  <template name="cern:dre">
    <Indicatiu>
      <futur>
        <p><i>dré</i></p><p><i>dràs</i></p><p><i>drà</i></p>
        <p><i>drem</i></p><p><i>dreu</i></p><p><i>dran</i></p>
      </futur>
    </Indicatiu>
    <Condicional>
      <present>
        <p><i>dria</i></p><p><i>dries</i></p><p><i>dria</i></p>
        <p><i>dríem</i></p><p><i>dríeu</i></p><p><i>drien</i></p>
      </present>
    </Condicional>
    <!-- imperative was "cerp" -->
    <Imperatiu>
      <imperatiu-present>
        <p><i></i></p><p><i>i</i></p><p><i>em</i></p><p><i>eu</i></p><p><i>in</i></p>
      </imperatiu-present>
    </Imperatiu>
  </template>

  <template name="confon:dre">
    <Condicional>
      <present>
        <p><i>dria</i></p><p><i>dries</i></p><p><i>dria</i></p>
        <p><i>dríem</i></p><p><i>dríeu</i></p><p><i>drien</i></p>
      </present>
    </Condicional>
    <!-- confondre -> confós (was "confoós") -->
    <Particip>
      <particip>
        <p><i>--ós</i></p><p><i>--osa</i></p>
        <p><i>--osos</i></p><p><i>--oses</i></p>
      </particip>
    </Particip>
  </template>

  <template name="compla:ure">
    <Condicional>
      <present>
        <p><i>uria</i></p><p><i>uries</i></p><p><i>uria</i></p>
        <p><i>uríem</i></p><p><i>uríeu</i></p><p><i>urien</i></p>
      </present>
    </Condicional>
  </template>

  <template name="tr:aure">
    <Indicatiu>
      <futur>
        <p><i>auré</i></p><p><i>auràs</i></p><p><i>aurà</i></p>
        <p><i>aurem</i></p><p><i>aureu</i></p><p><i>auran</i></p>
      </futur>
    </Indicatiu>
    <Condicional>
      <present>
        <p><i>auria</i></p><p><i>auries</i></p><p><i>auria</i></p>
        <p><i>auríem</i></p><p><i>auríeu</i></p><p><i>aurien</i></p>
      </present>
    </Condicional>
    <Gerundi>
      <gerundi><p><i>aent</i></p></gerundi>
    </Gerundi>
    <!-- traure -> tret (was "trut") -->
    <Particip>
      <particip>
        <p><i>et</i></p><p><i>eta</i></p><p><i>ets</i></p><p><i>etes</i></p>
      </particip>
    </Particip>
  </template>

  <!-- ==== participles built from the wrong stem ====================== -->

  <template name="mou:re">
    <!-- moure -> mogut, beure -> begut, deure -> degut (was "mouut") -->
    <Particip>
      <particip>
        <p><i>-gut</i></p><p><i>-guda</i></p>
        <p><i>-guts</i></p><p><i>-gudes</i></p>
      </particip>
    </Particip>
  </template>

  <template name="d:ur">
    <!-- dur -> dut (was "ddut") -->
    <Particip>
      <particip>
        <p><i>ut</i></p><p><i>uda</i></p><p><i>uts</i></p><p><i>udes</i></p>
      </particip>
    </Particip>
  </template>

  <template name="aten:dre">
    <!-- atendre -> atès, entendre -> entès (was "atenès") -->
    <Particip>
      <particip>
        <p><i>--ès</i></p><p><i>--esa</i></p>
        <p><i>--esos</i></p><p><i>--eses</i></p>
      </particip>
    </Particip>
  </template>

  <template name="compon:dre">
    <!-- compondre -> compost, respondre -> respost (was "componès") -->
    <Particip>
      <particip>
        <p><i>-st</i></p><p><i>-sta</i></p><p><i>-sts</i></p><p><i>-stes</i></p>
      </particip>
    </Particip>
  </template>

  <template name="expen:dre">
    <!-- expendre -> expès (was "expenès") -->
    <Particip>
      <particip>
        <p><i>--ès</i></p><p><i>--esa</i></p>
        <p><i>--esos</i></p><p><i>--eses</i></p>
      </particip>
    </Particip>
  </template>

  <!-- ==== wrong subjunctives, imperatives and preterites ============= -->

  <template name="cal:dre">
    <!-- caldre is impersonal; the subjunctive read "calbi" -->
    <Subjuntiu>
      <present>
        <p><i>-</i></p><p><i>-</i></p><p><i>gui</i></p>
        <p><i>-</i></p><p><i>-</i></p><p><i>guin</i></p>
      </present>
    </Subjuntiu>
  </template>

  <template name="desclou:re">
    <!-- was "desclogés" -->
    <Subjuntiu>
      <imperfet>
        <p><i>-gués</i></p><p><i>-guessis</i></p><p><i>-gués</i></p>
        <p><i>-guéssim</i></p><p><i>-guéssiu</i></p><p><i>-guessin</i></p>
      </imperfet>
    </Subjuntiu>
  </template>

  <template name="v:iure">
    <!-- was "visgui"/"visgués"/"vient" -->
    <Subjuntiu>
      <present>
        <p><i>isqui</i></p><p><i>isquis</i></p><p><i>isqui</i></p>
        <p><i>isquem</i></p><p><i>isqueu</i></p><p><i>isquin</i></p>
      </present>
      <imperfet>
        <p><i>isqués</i></p><p><i>isquessis</i></p><p><i>isqués</i></p>
        <p><i>isquéssim</i></p><p><i>isquéssiu</i></p><p><i>isquessin</i></p>
      </imperfet>
    </Subjuntiu>
    <Gerundi>
      <gerundi><p><i>ivint</i></p></gerundi>
    </Gerundi>
  </template>

  <template name="tren:car">
    <!-- first person read "trenqi" -->
    <Subjuntiu>
      <present>
        <p><i>qui</i></p><p><i>quis</i></p><p><i>qui</i></p>
        <p><i>quem</i></p><p><i>queu</i></p><p><i>quin</i></p>
      </present>
    </Subjuntiu>
  </template>

  <template name="d:ir">
    <!-- second person plural read "digue" -->
    <Subjuntiu>
      <present>
        <p><i>igui</i></p><p><i>iguis</i></p><p><i>igui</i></p>
        <p><i>iguem</i></p><p><i>igueu</i></p><p><i>iguin</i></p>
      </present>
    </Subjuntiu>
  </template>

  <template name="r:iure">
    <!-- second person plural read "rigue" -->
    <Subjuntiu>
      <present>
        <p><i>igui</i></p><p><i>iguis</i></p><p><i>igui</i></p>
        <p><i>iguem</i></p><p><i>igueu</i></p><p><i>iguin</i></p>
      </present>
    </Subjuntiu>
  </template>

  <template name="preg:ar">
    <!-- third person singular read "pregi" -->
    <Imperatiu>
      <imperatiu-present>
        <p><i>a</i></p><p><i>ui</i></p><p><i>uem</i></p>
        <p><i>ueu</i></p><p><i>uin</i></p>
      </imperatiu-present>
    </Imperatiu>
  </template>

  <template name="toss:ir">
    <!-- imperative read "tuss" -->
    <Imperatiu>
      <imperatiu-present>
        <p><i>---us</i></p><p><i>--ussi</i></p><p><i>im</i></p>
        <p><i>iu</i></p><p><i>--ussin</i></p>
      </imperatiu-present>
    </Imperatiu>
  </template>

  <template name="est:ar">
    <!-- the gerund was the Spanish "estando" and the imperative "está" -->
    <Gerundi>
      <gerundi><p><i>ant</i></p></gerundi>
    </Gerundi>
    <Imperatiu>
      <imperatiu-present>
        <p><i>igues</i></p><p><i>igui</i></p><p><i>iguem</i></p>
        <p><i>igueu</i></p><p><i>iguin</i></p>
      </imperatiu-present>
    </Imperatiu>
  </template>

  <template name="h:aver">
    <!-- "havem/haveu" for "hem/heu"; haver has no imperative -->
    <Indicatiu>
      <present>
        <p><i>e</i></p><p><i>as</i></p><p><i>a</i></p>
        <p><i>em</i></p><p><i>eu</i></p><p><i>an</i></p>
      </present>
    </Indicatiu>
    <Imperatiu>
      <imperatiu-present>
        <p><i>-</i></p><p><i>-</i></p><p><i>-</i></p><p><i>-</i></p><p><i>-</i></p>
      </imperatiu-present>
    </Imperatiu>
  </template>

  <!-- The second person of the preterite dropped a syllable:
       "comples" for "complires", "serves" for "servires". -->
  <template name="compl:ir">
    <Indicatiu>
      <passat-simple>
        <p><i>í</i></p><p><i>ires</i></p><p><i>í</i></p>
        <p><i>írem</i></p><p><i>íreu</i></p><p><i>iren</i></p>
