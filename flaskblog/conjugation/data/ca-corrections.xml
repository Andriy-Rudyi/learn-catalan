  <!-- escriure and its family shared "r:iure" with riure, which gave
       "escriem" for "escrivim" and "escrigut" for "escrit" -->
  <template name="escr:iure" new="true" base="r:iure">
    <Indicatiu>
      <present>
        <p><i>ic</i></p><p><i>ius</i></p><p><i>iu</i></p>
        <p><i>ivim</i></p><p><i>iviu</i></p><p><i>iuen</i></p>
      </present>
      <imperfet>
        <p><i>ivia</i></p><p><i>ivies</i></p><p><i>ivia</i></p>
        <p><i>ivíem</i></p><p><i>ivíeu</i></p><p><i>ivien</i></p>
      </imperfet>
    </Indicatiu>
    <Gerundi>
      <gerundi><p><i>ivint</i></p></gerundi>
    </Gerundi>
    <Particip>
      <particip>
        <p><i>it</i></p><p><i>ita</i></p><p><i>its</i></p><p><i>ites</i></p>
      </particip>
    </Particip>
  </template>

  <!-- néixer takes ei in the stressed forms; nàixer (Valencian) keeps ai -->
  <template name="néix:er" new="true" base="n:àixer">
    <Indicatiu>
      <present>
        <p><i>eixo</i></p><p><i>eixes</i></p><p><i>eix</i></p>
        <p><i>aixem</i></p><p><i>aixeu</i></p><p><i>eixen</i></p>
      </present>
    </Indicatiu>
    <Subjuntiu>
      <present>
        <p><i>eixi</i></p><p><i>eixis</i></p><p><i>eixi</i></p>
        <p><i>aixem</i></p><p><i>aixeu</i></p><p><i>eixin</i></p>
      </present>
    </Subjuntiu>
    <Imperatiu>
      <imperatiu-present>
        <p><i>eix</i></p><p><i>eixi</i></p><p><i>aixem</i></p>
        <p><i>aixeu</i></p><p><i>eixin</i></p>
      </imperatiu-present>
    </Imperatiu>
  </template>

  <!-- vendre is unstressed in the third person (ven), unlike revendre
       (revèn) which keeps "malven:dre" -->
  <template name="ven:dre" new="true" base="malven:dre">
    <Indicatiu>
      <present>
        <p><i>c</i></p><p><i>s</i></p><p><i></i></p>
        <p><i>em</i></p><p><i>eu</i></p><p><i>en</i></p>
      </present>
    </Indicatiu>
    <Imperatiu>
      <imperatiu-present>
        <p><i></i></p><p><i>gui</i></p><p><i>guem</i></p>
        <p><i>gueu</i></p><p><i>guin</i></p>
      </imperatiu-present>
    </Imperatiu>
  </template>

  <!-- the -metre verbs: admetre -> admès, not "admetut" -->
  <template name="met:re" new="true" base="perd:re">
    <Particip>
      <particip>
        <p><i>--ès</i></p><p><i>--esa</i></p>
        <p><i>--esos</i></p><p><i>--eses</i></p>
      </particip>
    </Particip>
  </template>

  <!-- -prendre, -pendre and -fendre: comprendre -> comprès,
       aprendre -> après, and the stressed third person comprèn -->
  <template name="compren:dre" new="true" base="col:dre">
    <Indicatiu>
      <present>
        <p><i>c</i></p><p><i>s</i></p><p><i>--èn</i></p>
        <p><i>em</i></p><p><i>eu</i></p><p><i>en</i></p>
      </present>
    </Indicatiu>
    <Particip>
      <particip>
        <p><i>--ès</i></p><p><i>--esa</i></p>
        <p><i>--esos</i></p><p><i>--eses</i></p>
      </particip>
    </Particip>
  </template>

  <!-- prendre itself: pres, and an unstressed "pren" -->
  <template name="pren:dre" new="true" base="col:dre">
    <Particip>
      <particip>
        <p><i>-s</i></p><p><i>-sa</i></p><p><i>-sos</i></p><p><i>-ses</i></p>
      </particip>
    </Particip>
  </template>

  <!-- defendre -> defès, suspendre -> suspès -->
  <template name="defen:dre" new="true" base="col:dre">
    <Indicatiu>
