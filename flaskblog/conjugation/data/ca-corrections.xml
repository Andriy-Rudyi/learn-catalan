        <p><i>em</i></p><p><i>eu</i></p><p><i>en</i></p>
      </present>
    </Indicatiu>
    <Subjuntiu>
      <present>
        <p><i>--àpiga</i></p><p><i>--àpigues</i></p><p><i>--àpiga</i></p>
        <p><i>--apiguem</i></p><p><i>--apigueu</i></p><p><i>--àpiguen</i></p>
