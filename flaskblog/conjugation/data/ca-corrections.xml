        <p><i>írem</i></p><p><i>íreu</i></p><p><i>iren</i></p>
      </passat-simple>
    </Indicatiu>
  </template>

  <!-- fer keeps the unstressed forms (fas, fa); every prefixed verb of
       this template is stressed on the last syllable (desfàs, refà). -->
  <template name="desf:er">
    <Indicatiu>
      <present>
        <p><i>aig</i></p><p><i>às</i></p><p><i>à</i></p>
        <p><i>em</i></p><p><i>eu</i></p><p><i>an</i></p>
      </present>
    </Indicatiu>
  </template>

  <!-- ==== new templates ============================================= -->

  <template name="f:er" new="true" base="desf:er">
    <Indicatiu>
      <present>
        <p><i>aig</i></p><p><i>as</i></p><p><i>a</i></p>
        <p><i>em</i></p><p><i>eu</i></p><p><i>an</i></p>
      </present>
    </Indicatiu>
  </template>

